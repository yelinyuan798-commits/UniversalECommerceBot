# 可选：不填密钥也能用默认话术和商品规则；填写后默认客服可用 AI 改善表达。
API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
# false 可关闭 AI；修改此文件后重启工作台生效。
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=12
# Store locally only; never send cookies to chats or commit them.
COOKIES_STR=
HEARTBEAT_INTERVAL=15
LOG_LEVEL=INFO
