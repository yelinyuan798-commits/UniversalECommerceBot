# 可选：推荐在工作台“AI 设置”中填写并测试；不填密钥也能用默认话术和商品规则。
# 未保存工作台设置时才使用下面的旧环境配置；config/ai.local.json 保存后优先。
API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
# false 可关闭旧环境配置中的 AI；修改此文件后重启生效，工作台保存无需重启。
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=12
# Store locally only; never send cookies to chats or commit them.
COOKIES_STR=
HEARTBEAT_INTERVAL=15
LOG_LEVEL=INFO
